# OLLAMA_MODEL=vigogne-llama-3:latest
# OLLAMA_API_KEY=
# Set OLLAMA_API_KEY only when your reverse proxy or Ollama Cloud requires it.

# Official Ollama Cloud example for supported cloud models
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:120b

EMBEDDING_LOCAL_FILES_ONLY=1
