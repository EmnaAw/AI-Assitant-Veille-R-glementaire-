# RAG service Ollama settings.
# The repository root .env can also define these values for both projects.

OLLAMA_BASE_URL=https://your-colab-tunnel.trycloudflare.com
OLLAMA_MODEL=vigogne-llama-3:latest
RAG_LLM_MODEL=vigogne-llama-3:latest
# Leave empty for a Colab quick tunnel. Set only if your proxy enforces a bearer token.
OLLAMA_API_KEY=
OLLAMA_TIMEOUT=120

RAG_DB_DIR=./db_vigogne_bge_m3
RAG_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_LOCAL_FILES_ONLY=1
